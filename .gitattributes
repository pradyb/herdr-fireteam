# Normalize line endings: force LF so install.sh and the hook never get CRLF
# when checked out on Windows, and diffs stay clean across platforms.

* text=auto eol=lf

*.py       text eol=lf
*.sh       text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.svg      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
.gitignore text eol=lf

# Never touch these.
*.png      binary
*.jpg      binary
*.gif      binary
*.mp3      binary
*.ttf      binary
